# Vendored ethos (project-local): vox tracks the identity registry
# (identities/personalities/writing-styles/talents/roles/agents/teams) and the
# durable mission records (missions/ + missions.jsonl). Two things are ignored:
#   1. upstream team-repo dev scaffolding that rode along with the de-submodule
#   2. verbatim per-session activity logs (sessions/**/audit.jsonl) and locks —
#      these are runtime logs (like quarry captures) that must not enter the
#      public repo and would churn the tree on every action.
.punt-labs/ethos/.github/
.punt-labs/ethos/.envrc
.punt-labs/ethos/.biff
.punt-labs/ethos/.gitignore
.punt-labs/ethos/.markdownlint-cli2.jsonc
.punt-labs/ethos/.markdownlint.jsonc
.punt-labs/ethos/.claude/
.punt-labs/ethos/CHANGELOG.md
.punt-labs/ethos/README.md
.punt-labs/ethos/ethos.yaml
.punt-labs/ethos/sessions/
.punt-labs/ethos/missions/.create.lock

# Local-path counterpart: ethos writes per-session activity logs and locks
# under .punt-labs/local/ethos/sessions/ — same runtime churn as above, ignored.
# Both flat (sessions/<id>.audit.jsonl) and nested (sessions/<id>/audit.jsonl)
# layouts are covered so the layout documented in CLAUDE.md cannot re-dirty the
# tree; only the per-session ACTIVITY artifacts are ignored, not durable records.
.punt-labs/local/ethos/sessions/*.audit.jsonl
.punt-labs/local/ethos/sessions/*.lock
.punt-labs/local/ethos/sessions/**/audit.jsonl
.punt-labs/local/ethos/sessions/**/*.audit.jsonl
.punt-labs/local/ethos/sessions/**/*.lock

# Ethos writes the same per-session churn under the missions/ sibling:
# .punt-labs/local/ethos/missions/<mission-id>/<session-uuid>.{log.jsonl,lock}
# Note the extension is .log.jsonl here, not the .audit.jsonl the sessions
# block above matches -- mirroring that block literally would match nothing.
# The DURABLE mission record (contract.yaml, results.yaml, reflections.yaml,
# delegations/) lives under .punt-labs/ethos/missions/ and stays tracked; only
# this machine-local counterpart is ignored.
.punt-labs/local/ethos/missions/*.audit.jsonl
.punt-labs/local/ethos/missions/*.log.jsonl
.punt-labs/local/ethos/missions/*.lock
.punt-labs/local/ethos/missions/**/audit.jsonl
.punt-labs/local/ethos/missions/**/*.audit.jsonl
.punt-labs/local/ethos/missions/**/*.log.jsonl
.punt-labs/local/ethos/missions/**/*.lock

# Per-mission runtime lock in the durable tree. .create.lock (above) covers the
# registry-wide lock; this covers the one ethos takes on an individual mission.
.punt-labs/ethos/missions/*/.lock

# Per-mission verbatim activity logs written into the durable tree. Same class
# as sessions/**/audit.jsonl above — runtime churn, not a durable record.
.punt-labs/ethos/missions/**/log-*.jsonl

# Local-path root (vox-6r6o): ethos writes per-session runtime state under
# .punt-labs/local/ (currently just ethos/, but the whole subtree is machine-
# local churn — no vox source lives here). Specific sessions/ patterns above
# stay for clarity; this blanket ignore keeps future ethos-local artifacts out.
.punt-labs/local/

# Ethos's flock on a vendored identity file, taken while it rewrites one.
# Same convention as SiblingLock below, but written by ethos, not by vox.
.punt-labs/ethos/identities/*.lock

# SiblingLock (src/punt_vox/sibling_lock.py) guards a read-modify-write of a
# host file by flocking a sibling named .<host>.punt-import.lock. It releases
# the flock on exit but never unlinks the file, so a zero-byte lock is left
# behind next to every host it has ever guarded -- CLAUDE.md, .claude/
# settings.json, and any future host. Unanchored so it matches at any depth,
# including worktrees under .claude/worktrees/ and pytest temp roots.
*.punt-import.lock
